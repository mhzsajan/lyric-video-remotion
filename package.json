{
  "name": "lyric-overlay-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Renders a lyric-text overlay (H.264 mp4, white on black, blended Add/Screen) from a Song Timer .lrc, for layering over a Videosync2 camera feed in Ableton.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.js",
    "render": "node render.mjs",
    "preview": "node render.mjs --preview",
    "report": "node render.mjs --report-only",
    "prepare": "node render.mjs --prepare-only",
    "batch": "node render.mjs --batch",
    "check": "python scripts/check_output.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/media-utils": "4.0.529",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.529"
  }
}
